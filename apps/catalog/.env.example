# Catalog contact handles — PUBLIC contact identifiers, NOT secrets.
# These are the same handles printed on the storefront's contact buttons; safe
# to commit a copy here as an example. Read ONLY by lib/contact-env.ts (server).
#
# If a value is left blank, that channel's button simply does not render — the
# storefront degrades gracefully (no broken links, no crash).

# Full LINE URL, e.g. https://line.me/R/ti/p/@wnlq9
LINE_OFFICIAL_URL=

# WhatsApp: EITHER a full wa.me link (WHATSAPP_URL, takes priority — used as-is,
# no pre-filled message) OR a bare number with country code, no '+' (WHATSAPP_NUMBER,
# e.g. 66812345678 — builds a wa.me/<number>?text=... link with a pre-filled message).
WHATSAPP_URL=
WHATSAPP_NUMBER=

# Facebook Messenger page handle only (the part after m.me/), e.g. wnlq9
FB_MESSENGER_PAGE=

# Price-unlock passcode (temporary partner-preview price gate). The site is
# fully browsable without it; entering this passcode reveals real prices
# instead of the coarse ฿-tier icons. Public by necessity (NEXT_PUBLIC_ — read
# client-side), so treat it as a UX gate, not a real secret. Blank disables
# unlocking entirely (every passcode attempt fails).
NEXT_PUBLIC_PRICE_PASSCODE=

# Supabase project — see docs/superpowers/specs/2026-08-22-user-accounts-and-lists-design.md
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
